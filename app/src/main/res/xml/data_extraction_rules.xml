<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: keep the ride code out of cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rider_intercom_secret.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rider_intercom_secret.xml" />
    </device-transfer>
</data-extraction-rules>
